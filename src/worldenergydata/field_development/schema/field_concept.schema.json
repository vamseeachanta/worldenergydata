{
  "$defs": {
    "ConceptType": {
      "description": "Host / development concept options (briefing \u00a7A3).",
      "enum": [
        "fixed_jacket",
        "compliant_tower",
        "tlp",
        "spar",
        "semisub_fps",
        "fpso",
        "flng",
        "subsea_tieback",
        "subsea_to_shore",
        "nui"
