{
  "brand-guard.yml": {
    "name": "Brand Guard",
    "on": {
      "pull_request": {
        "paths": [
          "reports/**",
          "scripts/**",
          ".github/workflows/brand-guard.yml"
        ]
      },
      "push": {
        "branches": [
          "main"
        ],
        "paths": [
          "reports/**",
          "scripts/**"
        ]
      }
    },
    "jobs": {
      "brand-guard": {
        "name": null,
        "if": null
      }
    }
  },
  "ci.yml": {
    "name": "CI",
    "on": {
      "push": {
        "branches": [
          "main",
          "develop"
        ]
      },
      "pull_request": {
        "types": [
          "opened",
          "synchronize",
          "reopened",
          "edited"
        ]
      },
      "schedule": [
        {
          "cron": "17 9 * * *"
        }
      ],
      "workflow_dispatch": ""
    },
    "jobs": {
      "mode": {
        "name": "Gate mode",
        "if": null
      },
      "domain-tests": {
        "name": null,
        "if": "!cancelled() && (needs.mode.result != 'success' || needs.mode.outputs.replay != 'true') && github.event_name == 'pull_request'"
      },
      "test": {
        "name": "Test Python ${{ matrix.python-version }}",
        "if": "!cancelled() && (needs.mode.result != 'success' || needs.mode.outputs.replay != 'true') && ( github.event_name == 'push' || github.event_name == 'schedule' || github.event_name == 'workflow_dispatch' || (github.event_name == 'pull_request' &&\n contains(github.event.pull_request.labels.*.name, 'ci-full')))"
      },
      "lint": {
        "name": "Lint (full)",
        "if": "!cancelled() && (needs.mode.result != 'success' || needs.mode.outputs.replay != 'true')"
      },
      "type-check": {
        "name": "Type Check (full)",
        "if": "!cancelled() && (needs.mode.result != 'success' || needs.mode.outputs.replay != 'true')"
      },
      "security": {
        "name": "Security Scan (full)",
        "if": "!cancelled() && (needs.mode.result != 'success' || needs.mode.outputs.replay != 'true')"
      },
      "build": {
        "name": "Build Package",
        "if": "!cancelled() && (needs.mode.result != 'success' || needs.mode.outputs.replay != 'true') && needs.lint.result == 'success'"
      },
      "docs": {
        "name": "Documentation (full)",
        "if": "!cancelled() && (needs.mode.result != 'success' || needs.mode.outputs.replay != 'true') && github.event_name == 'pull_request'"
      },
      "lint-gate": {
        "name": "Lint",
        "if": "${{ !cancelled() }}"
      },
      "type-check-gate": {
        "name": "Type Check",
        "if": "${{ !cancelled() }}"
      },
      "security-gate": {
        "name": "Security Scan",
        "if": "${{ !cancelled() }}"
      },
      "docs-gate": {
        "name": "Documentation",
        "if": "${{ !cancelled() && github.event_name == 'pull_request' }}"
      },
      "pr-gate": {
        "name": "Test (PR gate)",
        "if": "${{ !cancelled() && github.event_name == 'pull_request' }}"
      }
    }
  },
  "docs.yml": {
    "name": "Build API Docs",
    "on": {
      "push": {
        "branches": [
          "main"
        ],
        "paths": [
          "src/**",
          "docs/api/**",
          "mkdocs.yml"
        ]
      },
      "pull_request": {
        "paths": [
          "src/**",
          "docs/api/**",
          "mkdocs.yml"
        ]
      },
      "workflow_dispatch": ""
    },
    "jobs": {
      "docs": {
        "name": null,
        "if": null
      }
    }
  },
  "nightly.yml": {
    "name": "Nightly",
    "jobs": {
      "full-test-suite": {
        "name": "Full Test Suite"
      },
      "dependency-audit": {
        "name": "Dependency Audit"
      },
      "performance-benchmark": {
        "name": "Performance Benchmark"
      },
      "notify-failure": {
        "name": "Notify on Failure"
      }
    }
  },
  "pages.yml": {
    "name": "Deploy Data Outputs to Pages",
    "jobs": {
      "build": {
        "name": null
      },
      "deploy": {
        "name": null
      }
    }
  },
  "pr-validation.yml": {
    "name": "PR Validation",
    "on": {
      "pull_request": {
        "types": [
          "opened",
          "synchronize",
          "reopened",
          "edited"
        ]
      }
    },
    "jobs": {
      "pr-title": {
        "name": "Validate PR Title",
        "if": null
      },
      "file-size": {
        "name": "Check File Sizes",
        "if": null
      },
      "sensitive-files": {
        "name": "Check Sensitive Files",
        "if": null
      },
      "changelog-check": {
        "name": "Changelog Check",
        "if": null
      },
      "code-owners": {
        "name": "Code Owners Check",
        "if": null
      },
      "pack-lint": {
        "name": "Lint Changed Knowledge Packs",
        "if": null
      }
    }
  },
  "release.yml": {
    "name": "Release",
    "jobs": {
      "validate": {
        "name": "Validate Release"
      },
      "test": {
        "name": "Run Tests"
      },
      "build": {
        "name": "Build Package"
      },
      "publish-testpypi": {
        "name": "Publish to Test PyPI"
      },
      "publish-pypi": {
        "name": "Publish to PyPI"
      },
      "github-release": {
        "name": "Create GitHub Release"
      }
    }
  }
}
