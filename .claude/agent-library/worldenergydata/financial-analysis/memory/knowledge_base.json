    "categories": {
      "financial_metrics": {
        "npv": {
          "definition": "Net Present Value - present value of cash flows minus initial investment",
          "formula": "NPV = Σ(CFt / (1+r)^t) - I0",
          "use_case": "Investment evaluation"
        },
        "irr": {
          "definition": "Internal Rate of Return - discount rate that makes NPV zero",
          "formula": "0 = Σ(CFt / (1+IRR)^t) - I0",
          "use_case": "Return comparison"
        },
        "lcoe": {
          "definition": "Levelized Cost of Energy",
          "formula": "LCOE = (CAPEX + Σ(OPEX/(1+r)^t)) / Σ(Energy/(1+r)^t)",
          "use_case": "Energy cost comparison"
        }
      },
